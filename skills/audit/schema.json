{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"B-owned LLM response schema; not a replacement for A public output schemas",
  "type":"object","required":["findings"],"additionalProperties":false,
  "properties":{"findings":{"type":"array","maxItems":200,"items":{
    "type":"object","additionalProperties":false,
    "required":["record_id","issue_domain","code","severity","confidence","evidence_version_ids","proposed_action","reason"],
    "properties":{
      "record_id":{"type":["string","null"]},"indicator_id":{"type":["string","null"]},
      "issue_domain":{"enum":["EXTRACTION","CLASSIFICATION","NORMALIZATION","COVERAGE","FILTER"]},
      "page_no":{"type":["integer","null"],"minimum":1},"bbox":{"type":["array","null"],"minItems":4,"maxItems":4,"items":{"type":"number"}},
      "source_kind":{"enum":["text","table_cell","figure","page_ocr",null]},
      "code":{"enum":["A-IND-MISMATCH","A-VAR-MISMATCH","A-SCOPE-MIX","A-UNIT-MISMATCH","A-YEAR-MISMATCH","A-BOUNDARY-MISSING","A-VALUE-IMPLAUSIBLE","A-CROSS-RECORD","A-DUPLICATE-UNMERGED","A-NORMALIZATION-INVALID","A-FILTER-OVERDROP","A-MISSING-KEY","A-EVIDENCE-WEAK","A-CLOSED-SET-GAP","A-CONTEXT-INSUFFICIENT","A-EXTRACT-VALUE","A-EXTRACT-CONTEXT","A-EXTRACT-PAGE","A-TRACE-MISSING"]},
      "severity":{"enum":["BLOCK","WARN","INFO"]},"confidence":{"type":"number","minimum":0,"maximum":1},
      "evidence_version_ids":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"string"}},
      "evidence_span":{"type":["string","null"],"maxLength":300},"observed":{"type":["string","null"],"maxLength":512},
      "expected":{"type":["string","null"],"maxLength":512},"proposed_action":{"enum":["KEEP","REMAP","CORRECT_VALUE","MARK_MISSING","MERGE_DUPLICATE","ESCALATE"]},
      "proposed_value":{"type":["number","null"]},"proposed_variable":{"type":["string","null"]},"reason":{"type":"string","minLength":1,"maxLength":512}
    }
  }}}
}
