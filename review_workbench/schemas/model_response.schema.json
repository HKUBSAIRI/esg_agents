{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "record_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "verdict": {
            "enum": [
              "CONFIRMED",
              "SUSPECT",
              "REJECTED",
              "INSUFFICIENT"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "record_uid",
          "verdict",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 20
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_uid": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1000
          },
          "code": {
            "enum": [
              "A-IND-MISMATCH",
              "A-VAR-MISMATCH",
              "A-SCOPE-MIX",
              "A-UNIT-MISMATCH",
              "A-YEAR-MISMATCH",
              "A-BOUNDARY-MISSING",
              "A-VALUE-IMPLAUSIBLE",
              "A-CROSS-RECORD",
              "A-DUPLICATE-UNMERGED",
              "A-AGGREGATION-WRONG",
              "A-MISSING-KEY",
              "A-EVIDENCE-WEAK",
              "A-CLOSED-SET-GAP"
            ]
          },
          "severity": {
            "enum": [
              "BLOCK",
              "WARN",
              "INFO"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "minItems": 1,
            "maxItems": 40
          },
          "evidence_span": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 300
          },
          "observed": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512
          },
          "expected": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512
          },
          "proposed_action": {
            "enum": [
              "KEEP",
              "REMAP",
              "CORRECT_VALUE",
              "MARK_MISSING",
              "MERGE_DUPLICATE",
              "ESCALATE"
            ]
          },
          "proposed_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "proposed_variable": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "record_uid",
          "code",
          "severity",
          "confidence",
          "evidence_ids",
          "proposed_action",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "record_verdicts",
    "findings"
  ],
  "additionalProperties": false
}
