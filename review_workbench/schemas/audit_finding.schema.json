{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "record_uid": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 1000
    },
    "code": {
      "enum": [
        "A-IND-MISMATCH",
        "A-VAR-MISMATCH",
        "A-SCOPE-MIX",
        "A-UNIT-MISMATCH",
        "A-YEAR-MISMATCH",
        "A-BOUNDARY-MISSING",
        "A-VALUE-IMPLAUSIBLE",
        "A-CROSS-RECORD",
        "A-DUPLICATE-UNMERGED",
        "A-AGGREGATION-WRONG",
        "A-MISSING-KEY",
        "A-EVIDENCE-WEAK",
        "A-CLOSED-SET-GAP"
      ]
    },
    "severity": {
      "enum": [
        "BLOCK",
        "WARN",
        "INFO"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "minItems": 1,
      "maxItems": 40
    },
    "evidence_span": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 300
    },
    "observed": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    },
    "expected": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    },
    "proposed_action": {
      "enum": [
        "KEEP",
        "REMAP",
        "CORRECT_VALUE",
        "MARK_MISSING",
        "MERGE_DUPLICATE",
        "ESCALATE"
      ]
    },
    "proposed_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "proposed_variable": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "audit_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "pid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "indicator_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "review_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "model_call_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 120
    }
  },
  "required": [
    "record_uid",
    "code",
    "severity",
    "confidence",
    "evidence_ids",
    "proposed_action",
    "reason",
    "finding_id",
    "audit_run_id",
    "pid",
    "indicator_id",
    "review_policy_version",
    "model_call_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "severity": {
            "const": "BLOCK"
          }
        }
      },
      "then": {
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0.7
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposed_action": {
            "const": "CORRECT_VALUE"
          }
        }
      },
      "then": {
        "required": [
          "proposed_value",
          "evidence_span"
        ],
        "properties": {
          "proposed_value": {
            "type": "number"
          },
          "evidence_span": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  ]
}
